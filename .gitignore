# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
build/
*.tsbuildinfo

# turbo
.turbo/

# env
.env
.env.local
.env.*.local

# prisma
packages/db/prisma/*.db
packages/db/prisma/migrations/dev.db*

# uploads (served from VPS disk in prod; local dev uploads are ignored).
# Keep this anchored to the public dirs — a bare `uploads/` also swallows source
# folders such as apps/web/components/uploads/.
apps/*/public/uploads/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
