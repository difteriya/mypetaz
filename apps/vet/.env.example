# Copy to .env.local for local dev. Shares the same DB + AUTH_SECRET as apps/web.

DATABASE_URL="postgresql://mypet:mypet@localhost:5432/mypet?schema=public"

# Must match apps/web's AUTH_SECRET for a shared session.
AUTH_SECRET=""

