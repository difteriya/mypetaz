# Copy to .env.local for local dev.

# Shared PostgreSQL (same instance as the vet app — see docker-compose.yml).
DATABASE_URL="postgresql://mypet:mypet@localhost:5432/mypet?schema=public"

# Auth.js (NextAuth v5). Generate a value with:  npx auth secret
AUTH_SECRET=""

# Optional social login — leave blank to hide those buttons (PLAN.md §2.8).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# Production only: shared session cookie across mypet.az + vet.mypet.az.
# Leave UNSET on localhost (ports can't share a cookie domain).
# AUTH_COOKIE_DOMAIN=.mypet.az

# Public base URL used in notification emails.
APP_URL="http://localhost:3000"

# Email (notifications). Without RESEND_API_KEY, emails no-op (log only).
# RESEND_API_KEY=
# EMAIL_FROM="mypet.az <noreply@mypet.az>"
