# ─────────────────────────────────────────────────────────────────────────────
# Production environment variables (Plesk → Node.js → "Custom environment
# variables" for EACH domain). Do NOT commit real secrets — this is a template.
#
# AUTH_SECRET, AUTH_COOKIE_DOMAIN and DATABASE_URL MUST be identical on both
# apps (shared login session + shared DB). AUTH_URL differs per domain.
# ─────────────────────────────────────────────────────────────────────────────

# --- Shared (set the SAME value on web + vet) ---
NODE_ENV=production

# PostgreSQL created in Plesk (Databases → PostgreSQL). schema=public required.
DATABASE_URL=postgresql://mypet:STRONG_PASSWORD@localhost:5432/mypet?schema=public

# Generate once with: openssl rand -base64 32   (same value on both apps!)
AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32

# Parent-domain cookie so the login is shared between mypet.az and vet.mypet.az.
AUTH_COOKIE_DOMAIN=.mypet.az

# Public URLs used for cross-app links and emails.
NEXT_PUBLIC_WEB_APP_URL=https://mypet.az
NEXT_PUBLIC_VET_APP_URL=https://vet.mypet.az
APP_URL=https://mypet.az

# Transactional email (Resend). Optional but needed for notifications/approval mail.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=mypet.az <noreply@mypet.az>

# Where uploaded images are written & served from. Point OUTSIDE the git checkout
# so redeploys/re-clones never wipe user uploads (see DEPLOY-PLESK.md, step 7).
UPLOAD_DIR=/var/www/vhosts/mypet.az/uploads

# Optional social login (leave unset to hide the buttons).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# --- Per-app: set AUTH_URL to the app's OWN domain ---
# On the mypet.az (web) app:
AUTH_URL=https://mypet.az
# On the vet.mypet.az app, use instead:
# AUTH_URL=https://vet.mypet.az
