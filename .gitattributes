# Normalize line endings to LF across all platforms.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Lockfile: keep as-is, mark generated in diffs.
pnpm-lock.yaml -diff linguist-generated
